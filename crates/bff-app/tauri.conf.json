{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SproutCrew",
  "version": "2.1.0",
  "identifier": "app.sproutcrew.mac",
  "build": {
    "frontendDist": "./ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SproutCrew",
        "width": 1120,
        "height": 780,
        "minWidth": 880,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 22
        },
        "backgroundColor": "#F7F3EC"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "externalBin": [
      "binaries/typst"
    ],
    "resources": {
      "binaries/licenses/THIRD-PARTY-NOTICES.txt": "licenses/THIRD-PARTY-NOTICES.txt",
      "binaries/licenses/typst-LICENSE.txt": "licenses/typst-LICENSE.txt",
      "binaries/licenses/typst-NOTICE.txt": "licenses/typst-NOTICE.txt"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "./Entitlements.plist"
    }
  }
}
