        "command": "/bin/zsh -lc \"python3 -c 'from pathlib import Path\npath = Path(\\\"artifact.md\\\")\noriginal = path.read_bytes()\nchanges = [\n    (b\\\"Total working days available: 25.\\\", \\\"Total working days available: 20 (4 weeks × 5 days per week).\\\".encode()),\n    (b\\\"Total working days: 25 (as stated in the brief).\\\", b\\\"Total working days stated in the brief: 25 (conflicts with the computed 20).\\\"),\n]\nupdated = original\nfor old, new in changes:\n    assert updated.count(old) == 1\n    updated = updated.replace(old, new, 1)\npath.write_bytes(updated)\nassert path.read_bytes() == updated\nrestored = updated\nfor old, new in changes:\n    restored = restored.replace(new, old, 1)\nassert restored == original\nprint(\\\"Verified: only the two F1 lines changed.\\\")'\"",
